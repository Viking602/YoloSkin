{
  "name": "yoloskin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "build": "bun run --cwd web build",
    "check": "bun run build && bun run typecheck && bun run test && bun run deploy:dry-run",
    "deploy": "bun run build && wrangler deploy",
    "deploy:dry-run": "WRANGLER_LOG_PATH=/tmp/yoloskin-wrangler.log wrangler deploy --dry-run",
    "dev": "bun run build && wrangler dev",
    "d1:migrate:local": "wrangler d1 migrations apply yoloskin-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply yoloskin-db --remote",
    "test": "WRANGLER_LOG_PATH=/tmp/yoloskin-wrangler.log vitest run",
    "typecheck": "tsc --noEmit && bun run --cwd web typecheck && WRANGLER_LOG_PATH=/tmp/yoloskin-wrangler.log wrangler types --check"
  },
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261022.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0",
    "@cloudflare/vitest-plugin": "^1.4.7"
  },
  "engines": {
    "node": ">=22.12.0",
    "bun": ">=1.4.0"
  }
}
